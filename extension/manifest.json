{
  "manifest_version": 3,
  "name": "Fake Profile Detector",
  "version": "1.0",
  "description": "Detects fake profiles on Twitter/X, Instagram, TikTok and Facebook using AI.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "shared/extractor.js",
        "shared/normalizer.js",
        "shared/featureEngineering.js",
        "shared/explain.js",
        "shared/risk.js",
        "platforms/twitter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "shared/extractor.js",
        "shared/normalizer.js",
        "shared/featureEngineering.js",
        "shared/explain.js",
        "shared/risk.js",
        "platforms/instagram.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "shared/extractor.js",
        "shared/normalizer.js",
        "shared/featureEngineering.js",
        "shared/explain.js",
        "shared/risk.js",
        "platforms/tiktok.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://web.facebook.com/*"
      ],
      "js": [
        "shared/extractor.js",
        "shared/normalizer.js",
        "shared/featureEngineering.js",
        "shared/explain.js",
        "shared/risk.js",
        "platforms/facebook.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://smart-fake-profile-detection.onrender.com/*",
    "https://zoxmchlwfxnudopusksr.supabase.co/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*"
  ]
}
